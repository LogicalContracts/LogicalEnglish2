    "build": "esbuild src/client.ts --bundle --outfile=dist/client.js --format=esm && esbuild src/server.ts --bundle --outfile=dist/server.js --format=esm",
    "start": "serve ."
  },
  "dependencies": {
    "monaco-editor": "^0.45.0",
    "monaco-languageclient": "^7.0.1",
