{
  "name": "le-editor",
  "version": "1.0.0",
  "description": "Logical English Editor",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/client.ts --bundle --outfile=dist/client.js --format=esm && esbuild src/server.ts --bundle --outfile=dist/server.js --format=esm && esbuild src/graph-client.ts --bundle --outfile=dist/graph-client.js --format=esm",
    "start": "serve ."
  },
  "dependencies": {
    "cose-base": "^2.2.0",
    "cytoscape": "^3.33.3",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-elk": "^2.3.0",
    "cytoscape-fcose": "^2.2.0",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.1",
    "layout-base": "^2.0.1",
    "monaco-editor": "^0.45.0",
    "monaco-languageclient": "^7.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "esbuild": "^0.19.11",
    "serve": "^14.2.1",
    "typescript": "^5.3.3"
  }
}
