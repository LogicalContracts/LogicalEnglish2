{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "logical-english": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "mcp-remote", "http://127.0.0.1:3050/mcp"]
    }
  },
  "provider": {
    "together": {
      "options": {
        "baseURL": "https://api.together.xyz/v1"
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/le_assistant/**": "allow",
      "{{PROJECT_ROOT}}/docs/**": "allow",
      "{{PROJECT_ROOT}}/examples/moreExamples/**": "allow"
    }
  }
}
