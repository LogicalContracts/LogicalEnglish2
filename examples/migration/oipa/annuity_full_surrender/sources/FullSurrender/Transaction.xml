<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic OIPA configuration (InsurLE2 Phase 2b): the full surrender of
     a deferred annuity: the whole account value, less the surrender charge
     of the policy year (no free amount), and the policy's status. -->
<Transaction>
  <Math>
    <MathVariables>
      <MathVariable VARIABLENAME="EffectiveDateMV" TYPE="FIELD" DATATYPE="DATE">Activity:EffectiveDate</MathVariable>
      <MathVariable VARIABLENAME="AccountValueMV" TYPE="POLICYFIELD" DATATYPE="DECIMAL">AccountValue</MathVariable>
      <MathVariable VARIABLENAME="IssueDateMV" TYPE="POLICYFIELD" DATATYPE="DATE">IssueDate</MathVariable>
      <MathVariable VARIABLENAME="DurationMV" TYPE="FUNCTION" DATATYPE="INTEGER">DurationOf(IssueDateMV,EffectiveDateMV)</MathVariable>
      <MathVariable VARIABLENAME="PolicyYearMV" TYPE="EXPRESSION" DATATYPE="INTEGER">DurationMV + 1</MathVariable>
      <MathVariable VARIABLENAME="SurrenderChargeRateMV" TYPE="RATE" DATATYPE="DECIMAL" DEFAULT="0">
        <Parameters>
          <RateDescription>SurrenderCharge</RateDescription>
          <EffectiveDate>Activity:EffectiveDate</EffectiveDate>
          <RateCriteria NAME="Duration">PolicyYearMV</RateCriteria>
        </Parameters>
      </MathVariable>
      <MathVariable VARIABLENAME="SurrenderChargeMV" TYPE="EXPRESSION" DATATYPE="DECIMAL" ROUND="2">AccountValueMV * SurrenderChargeRateMV</MathVariable>
      <MathVariable VARIABLENAME="SurrenderValueMV" TYPE="EXPRESSION" DATATYPE="DECIMAL" ROUND="2" LOG="Yes">AccountValueMV - SurrenderChargeMV</MathVariable>
      <MathVariable VARIABLENAME="ClosedValueMV" TYPE="VALUE" DATATYPE="DECIMAL">0</MathVariable>
      <MathVariable VARIABLENAME="SurrenderedStatusMV" TYPE="VALUE" DATATYPE="TEXT">Surrendered</MathVariable>
    </MathVariables>
  </Math>
</Transaction>
