# The spending policy of the Logical English twin hash_threshold.
#
# source: the Bitcoin Core Miniscript tests
#         https://github.com/bitcoin/bitcoin/blob/master/src/test/miniscript_tests.cpp
#
# it is Miniscript (or a descriptor) as it stands.
# try it in Minsc (policy -> Miniscript -> Script -> address, in the browser):
#     https://min.sc/#c=//%20Two%20of%20a%20signature,%20a%20SHA-256%20preimage%20and%20a%20HASH160%20preimage%0A//%20The%20Logical%20English%20twin's%20policy%20(InsurLE2/migration/miniscript).%0A$key_holder%20=%20025cbdf0646e5db4eaa398f365f2ea7a0e3d419b7e0330e39ce92bddedcac4f9bc;%20%20%20//%20the%20key%20holder%20(as%20in%20the%20source)%0A$payment_secret%20=%20e38990d0c7fc009880a9c07c23842e886c6bbdc964ce6bdd5817ad357335ee6f;%20%20%20//%20the%20payment%20secret,%20sha256%20(as%20in%20the%20source)%0A$release_secret%20=%20dd69735817e0e3f6f826a9238dc2e291184f0131;%20%20%20//%20the%20release%20secret,%20hash160%20(as%20in%20the%20source)%0A%0Athresh(2,pk($key_holder),sha256($payment_secret),hash160($release_secret))%0A
#
# File > Open in the Logical English editor translates this file into the twin.

025cbdf0646e5db4eaa398f365f2ea7a0e3d419b7e0330e39ce92bddedcac4f9bc = the key holder
e38990d0c7fc009880a9c07c23842e886c6bbdc964ce6bdd5817ad357335ee6f = the payment secret
dd69735817e0e3f6f826a9238dc2e291184f0131 = the release secret

# Two of a signature, a SHA-256 preimage and a HASH160 preimage
thresh(2,c:pk_h(025cbdf0646e5db4eaa398f365f2ea7a0e3d419b7e0330e39ce92bddedcac4f9bc),s:sha256(e38990d0c7fc009880a9c07c23842e886c6bbdc964ce6bdd5817ad357335ee6f),a:hash160(dd69735817e0e3f6f826a9238dc2e291184f0131))
