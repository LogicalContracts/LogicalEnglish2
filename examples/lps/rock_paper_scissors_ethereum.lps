% Companion file to rock_paper_scissors_ethereum.le
% (docs/le_lps_surface.md §7): the Ethereum bridge, which is external Prolog
% and has no business being written in English. Stubbed here so the program
% compiles and runs off-chain.

lps_my_account('0xLPS').

e_getBalance('0xLPS', 2000).

e_sendTransaction(_From, _To, _Prize, payment1).

e_existsTransactionReceipt(payment1).

% The chain itself, stubbed: one transaction, so the program has something to
% react to off-chain.
e_transaction('0xbob', rock, 1000, '0xLPS').
e_transaction('0xalice', paper, 1000, '0xLPS').
